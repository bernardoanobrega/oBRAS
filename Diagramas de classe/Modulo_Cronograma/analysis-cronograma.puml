@startuml cronograma-class-diagram
title OBRAS - Diagrama de Classes (Módulo Cronograma)

skinparam classAttributeIconSize 0
skinparam ClassFontSize 14
skinparam classBackgroundColor<<externa>> #EEEEEE
skinparam classBorderColor<<externa>> #888888
hide empty members

' ===== CLASSES EXTERNAS =====
class Obra <<externa>>
class Usuario <<externa>>

' ===== NÚCLEO =====
class Cronograma <<Entity>> {
  -id : Long
  -dataUltimaAtualizacao : LocalDate
  -status : StatusCronograma
  --
  +adicionarFase(nome : String, ordem : int, inicioPrevisto : LocalDate, fimPrevisto : LocalDate) : Fase
  +removerFase(idFase : int) : void
  +buscarFase(idFase : int) : Fase
  +validarSequenciaFases() : boolean
  +calcularPercentualGeral() : double
  +calcularDesvioPrazoDias(dataReferencia : LocalDate) : int
  +identificarFasesAtrasadas(dataReferencia : LocalDate) : Fase[]
  +cancelar()
}

class Fase <<Entity>> {
  -id : Long
  -idCronograma : Long
  -nome : String
  -descricao : String
  -ordem : int
  -inicioPrevisto : LocalDate
  -fimPrevisto : LocalDate
  -inicioReal : LocalDate
  -fimReal : LocalDate
  -status : StatusFase
  --
  +validarPeriodo() : boolean
  +registrarAvanco(percentualAcumulado : double, observacao : String, autor : Usuario) : AvancoFisico
  +calcularPercentualConcluido() : double
  +concluir(dataReal : LocalDate) : void
  +estaAtrasada(dataReferencia : LocalDate) : boolean
  +calcularDesvioDias(dataReferencia : LocalDate) : int
  +cancelar()
}

class AvancoFisico <<Entity>> {
  -id : Long
  -idFase : Long
  -dataRegistro : LocalDate
  -percentualAcumulado : double
  -observacao : String
  --
  +validar(percentualAnterior : double) : boolean
}

' ===== ENUMERAÇÕES =====
enum StatusCronograma {
  VAZIO
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusFase {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

' ===== RELAÇÕES =====
Cronograma "0..1" --> "1" Obra : informa
Cronograma "1" *-- "0..*" Fase : composto por
Fase "1" *-- "0..*" AvancoFisico : acumula
Usuario "1" --> "0..*" AvancoFisico : registra

@enduml
