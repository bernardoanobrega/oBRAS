@startuml cronograma-class-diagram
title OBRAS - Diagrama de Classes (Módulo Cronograma)

skinparam classAttributeIconSize 0
skinparam ClassFontSize 14
skinparam classBackgroundColor<<externa>> #EEEEEE
skinparam classBorderColor<<externa>> #888888
hide empty members

' ===== CLASSES EXTERNAS =====
class Obra <<externa>>
class Usuario <<externa>>

' ===== NÚCLEO =====
class Cronograma <<Entity>> {
  -id : Long
  -obraId : Long
  -dataUltimaAtualizacao : LocalDate
  -status : StatusCronograma
  --
  {static} +criar(obraId : Long) : Cronograma
  +adicionarFase(nome : String, descricao : String, ordem : int, inicioPrevisto : LocalDate, fimPrevisto : LocalDate) : Fase
  +removerFase(idFase : Long) : void
  +buscarFase(idFase : Long) : Fase
  +validarSequenciaFases() : boolean
  +calcularPercentualGeral() : double
  +calcularPercentualPlanejado(dataReferencia : LocalDate) : double
  +calcularDesvioPrazoDias(dataReferencia : LocalDate) : int
  +identificarFasesAtrasadas(dataReferencia : LocalDate) : Fase[]
  +cancelarCronograma() : void
  ~atualizarStatus() : void
}

class Fase <<Entity>> {
  -id : Long
  -nome : String
  -descricao : String
  -ordem : int
  -inicioPrevisto : LocalDate
  -fimPrevisto : LocalDate
  -inicioReal : LocalDate
  -fimReal : LocalDate
  -status : StatusFase
  --
  +validarPeriodo() : boolean
  +calcularDuracaoDias() : long
  +registrarAvanco(percentualAcumulado : double, observacao : String, autorId : Long) : AvancoFisico
  +calcularPercentualConcluido() : double
  +calcularPercentualPlanejado(dataReferencia : LocalDate) : double
  +concluir(dataReal : LocalDate) : void
  +estaAtrasada(dataReferencia : LocalDate) : boolean
  +calcularDesvioDias(dataReferencia : LocalDate) : int
  +classificarSituacao(dataReferencia : LocalDate) : SituacaoPrazo
  +atualizarDescricao(descricao : String) : void
  +cancelarFase() : void
}

class AvancoFisico <<Entity>> {
  -id : Long
  -autorId : Long
  -dataRegistro : LocalDate
  -percentualAcumulado : double
  -observacao : String
  --
  +validar(percentualAnterior : double) : boolean
}

' ===== ENUMERAÇÕES =====
enum StatusCronograma {
  VAZIO
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum StatusFase {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum SituacaoPrazo {
  NAO_INICIADA
  EM_DIA
  ATRASADA
  CONCLUIDA
  CANCELADA
}

' ===== RELAÇÕES =====
Cronograma "0..1" ..> "1" Obra : informa (obraId)
Cronograma "1" *-- "0..*" Fase : composto por
Fase "1" *-- "0..*" AvancoFisico : acumula
AvancoFisico "0..*" ..> "1" Usuario : registrado por (autorId)

@enduml
