@startuml compras-fornecedores-sequence
!theme plain
title Diagrama de Sequência - Criação de Pedido de Compra
skinparam maxMessageSize 150
autonumber

actor "Estoquista" as user
boundary "TelaPedidoCompra" as view <<view>>
control "ControlePedido" as ctrl <<Controller>>
entity "Fornecedor" as fornecedor <<Entity>>
entity "PedidoCompra" as pedido <<Entity>>
entity "ItemPedido" as item <<Entity>>
entity "Material" as material <<Entity>>

user -> view : Preencher dados do pedido e itens
activate view

view -> ctrl : criarPedido(fornecedorId, dadosPedido)
activate ctrl

ctrl -> fornecedor : buscarPorId(fornecedorId)
activate fornecedor
fornecedor --> ctrl : dadosFornecedor
deactivate fornecedor

ctrl --> pedido ** : <<create>> criarPedido(dadosFornecedor, dadosPedido)
activate pedido

loop Para cada item na lista da interface
    ctrl -> material : buscarPorId(materialId)
    activate material
    material --> ctrl : dadosMaterial
    deactivate material

    ctrl --> item ** : <<create>> criarItem(dadosMaterial, quantidade, valorUnitario)
    activate item
    ctrl -> item : calcularValorSubTotal()
    item --> ctrl : valorSubTotal
    deactivate item

    ctrl -> pedido : adicionarItem(item)
    pedido --> ctrl : confirmacaoAdicaoItem
end

ctrl -> pedido : calcularValorTotal()
pedido --> ctrl : valorTotal

ctrl -> pedido : salvarPedido()
pedido --> ctrl : pedidoSalvo
deactivate pedido

ctrl -> view : confirmarPedidoCriado(pedido)
view --> user : Exibir confirmação do pedido criado

deactivate ctrl
deactivate view
@enduml