@startuml compras-processo-activity
title Diagrama de Atividades - Solicitação, Cotação e Aprovação de Pedido de Compra

skinparam DefaultTextAlignment center
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #444444

start

:Estoquista identifica necessidade de reposição de materiais;
:Informar obra, prioridade e data prevista na TelaPedidoCompra;
:Criar PedidoCompra com status SOLICITADO:\ncriarPedido(obraId, solicitanteId, prioridade, dataPrevista);
:Registrar histórico de status (SOLICITADO);

repeat
  :Selecionar Material no catálogo:\nbuscarPorId(materialId);
  :Informar quantidade, valorUnitario\ne item do orçamento (opcional);
  :Adicionar item ao pedido:\nadicionarItem(material, quantidade, valorUnitario, itemOrcado);

  if (Item vinculado a ItemOrcado e excedeOrcamento()?) then (sim)
    :Exibir alerta de orçamento para o item;
  endif
repeat while (Deseja adicionar mais itens ao pedido?) is (sim) -> não

:Calcular valor total do pedido:\ncalcularValorTotal();
:Enviar para cotação:\nalterarStatus(EM_COTACAO);

repeat
  :Selecionar Fornecedor e verificar situação:\nbuscarPorId(fornecedorId); estaAtivo();

  if (Fornecedor está ativo?) then (sim)
    :Registrar cotação com valor total proposto e prazo de entrega:\nregistrarCotacao(fornecedor, valorTotalProposto, prazoEntregaDias);
  else (não)
    :Exibir mensagem de erro: "Fornecedor inativo ou inválido";
  endif
repeat while (Registrar outra cotação?) is (sim) -> não

if (Cotação aprovada pelo gestor?) then (sim)
  :Definir fornecedor do pedido pela cotação escolhida:\nselecionarCotacao(cotacao);
  :Confirmar compra junto ao fornecedor:\nalterarStatus(COMPRADO);
  :Lançar custo realizado nos itens vinculados ao orçamento\n(origem MATERIAL);
  :Salvar PedidoCompra:\nsalvarPedido();
  :Aguardar despacho do fornecedor:\nalterarStatus(EM_TRANSITO);
  :Exibir confirmação do pedido ao Estoquista;
else (não)
  :Cancelar solicitação de compra:\ncancelar(autor, instante);
  :Registrar cancelamento no histórico de status (CANCELADO);
endif

stop
@enduml
