@startuml estoque-conferencia-alerta-activity
title Diagrama de Atividades - Movimentação de Saída e Verificação de Estoque Mínimo

skinparam DefaultTextAlignment center
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #444444

start
:Estoquista informa material, canteiro e quantidade da saída para consumo;
:Buscar Material, Canteiro e o SaldoEstoque\ndo material naquele canteiro;

if (Saldo existe e quantidadeAtual >= quantidade solicitada?) then (sim)
  :Criar MovimentacaoEstoque (SAIDA_CONSUMO)\ncom canteiro de origem e autor;
  :Subtrair quantidade do SaldoEstoque:\nsubtrairSaldo(quantidade);
  :Salvar MovimentacaoEstoque e SaldoEstoque;
  :Verificar limite de segurança:\nverificarAlertaMinimo();

  if (quantidadeAtual <= quantidadeMinima?) then (sim)
    :Exibir alerta de estoque baixo para o material;
    :Oferecer geração de solicitação de reposição\n(PedidoCompra com status SOLICITADO);
  else (não)
    :Saldo permanece em nível regular;
  endif

  :Exibir confirmação de saída ao Estoquista;
else (não)
  :Bloquear movimentação de saída;
  :Exibir mensagem de erro: "Quantidade insuficiente em estoque";
endif

stop
@enduml
