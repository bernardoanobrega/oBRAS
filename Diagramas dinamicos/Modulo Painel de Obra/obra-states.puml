@startuml obra-states
title Diagrama de Estados da Classe Obra

skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #444444
  BackgroundColor<<final>> #EEEEEE
}
skinparam ArrowFontSize 12
skinparam NoteBackgroundColor #FFFBE6
hide empty description

' ===== ESTADOS =====
state PLANEJADA : Obra cadastrada, ainda não iniciada
state EM_ANDAMENTO : Obra em execução
state PARALISADA : Atividades interrompidas
state CONCLUIDA <<final>> : Obra finalizada
state CANCELADA <<final>> : Obra cancelada (nunca apagada)

' ===== TRANSIÇÕES =====
[*] --> PLANEJADA : cadastrar [usuário autorizado]
PLANEJADA --> EM_ANDAMENTO : iniciar() \n[há responsável técnico definido]
EM_ANDAMENTO --> PARALISADA : paralisar()
PARALISADA --> EM_ANDAMENTO : retomar()
EM_ANDAMENTO --> CONCLUIDA : concluir()\n/ encerrar alocações ativas\n(dataFim = hoje)
PLANEJADA --> CANCELADA : cancelar()\n/ encerrar alocações ativas\n(dataFim = hoje)
EM_ANDAMENTO --> CANCELADA : cancelar()\n/ encerrar alocações ativas\n(dataFim = hoje)
PARALISADA --> CANCELADA : cancelar()\n/ encerrar alocações ativas\n(dataFim = hoje)
CONCLUIDA --> [*]
CANCELADA --> [*]

@enduml