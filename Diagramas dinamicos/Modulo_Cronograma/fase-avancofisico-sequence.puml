@startuml fase-avancofisico-sequence
title Diagrama de Sequência - Registrar Avanço Físico

skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #444444
  LifeLineBorderColor #444444
  ArrowColor #444444
}
skinparam NoteBackgroundColor #FFFBE6
skinparam ArrowFontSize 12
hide footbox

actor "Usuário autorizado" as Usuário
participant ":Fase" as Fase
participant ":AvancoFisico" as Avanço
participant ":Cronograma" as Cronograma

' ===== REGISTRAR AVANCO FISICO =====
== Registrar Avanço Físico ==

Usuário -> Fase : registrarAvanco(...)
activate Fase

Fase -> Fase : validarPeriodo()
note right : Garante que a data está no escopo

Fase -> Avanço : validar(...)
activate Avanço

Avanço --> Fase : boolean (válido/inválido)
deactivate Avanço

alt Avanço válido
    Fase --> Avanço : create(...)
    activate Avanço
    Avanço --> Fase: instância criada
    deactivate Avanço

    Fase -> Fase : calcularPercentualConcluido()

    Fase -> Cronograma : calcularPercentualGeral()
    activate Cronograma
    Cronograma --> Fase : percentual atualizado
    deactivate Cronograma

    Fase --> Usuário : confirmação de sucesso
else Avanço inválido
    Fase --> Usuário : Exceção: percentual inválido
end

deactivate Fase

@enduml