@startuml alocacao-states
title Diagrama de Estados da Classe AlocacaoObra

skinparam state {
BackgroundColor #FFFFFF
BorderColor #444444
BackgroundColor<<final>> #EEEEEE
}
skinparam ArrowFontSize 12
skinparam NoteBackgroundColor #FFFBE6
hide empty description

' ===== ESTADOS =====
state ATIVA : Usuário alocado na obra; dataFim vazia
state ENCERRADA <<final>> : Alocação encerrada; dataFim preenchida

' ===== TRANSIÇÕES =====
[*] --> ATIVA : alocarUsuario(u, cargos)\n[sem alocação ativa do mesmo usuário na obra;\n cargos não vazio; dataInicio = hoje]
ATIVA --> ATIVA : definirCargos(cargos)\n[cargos não vazio]
ATIVA --> ENCERRADA : encerrarAlocacao()\n dataFim = hoje
ENCERRADA --> [*]

@enduml
