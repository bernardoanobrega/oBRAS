@startuml class-diagram
title OBRAS - Diagrama de Classes (Módulo Detalhes de Obra)

skinparam classAttributeIconSize 0
skinparam ClassFontSize 14
skinparam classBackgroundColor<<externa>> #EEEEEE
skinparam classBorderColor<<externa>> #888888
hide empty members

' ===== CLASSES EXTERNAS =====
class Usuario <<externa>>
class Cargo <<externa>>
class Orcamento <<externa>>
class Cronograma <<externa>>

' ===== NÚCLEO =====
class Obra <<Entity>> {
  -id : int
  -nome : String
  -descricao : String
  -tipologia : Tipologia
  -endereco : String
  -inicioPrevisto : Date
  -fimPrevisto : Date
  -status : StatusObra
  -responsavel : Usuario
  -art : String
  --
  +alocarUsuario(u : Usuario, cargos : Cargo[]) : AlocacaoObra
  +encerrarAlocacao(a : AlocacaoObra) : AlocacaoObra
  +adicionarFoto(arquivo : String, legenda : String, autor : Usuario) : RegistroFotografico
  +listarOcorrencias(inicio : Date, fim : Date) : Ocorrencia[]
  +alterarResponsavel() : void
  +iniciar()
  +paralisar()
  +retomar()
  +concluir()
  +cancelar()
}

class AlocacaoObra <<Entity>> {
  -id : int
  -idUsuario : int
  -cargos : Cargo[]
  -dataInicio : Date
  -dataFim : Date
  --
  +definirCargos(cargos : Cargo[]) : void
}

abstract class Auditavel <<Entity>> {
  -id : int
  -excluido : boolean
}

class RegistroDiario <<Entity>> {
  -id : int
  -idObra: int
  -data : Date
  -clima : CondicaoClimatica
  -descricao: String
  -equipePresente : AlocacaoObra[]
  --
  +registrarOcorrencia(cat : CategoriaOcorrencia, descricao : String, autor : Usuario) : Ocorrencia
  +alterarOcorrencia(Ocorrencia) : void
  +excluirOcorrencia() : Ocorrencia
}

class Ocorrencia <<Entity>> {
  -id : int
  -idRegistro: int
  -dataHora : DateTime
  -categoria : CategoriaOcorrencia
  -descricao : String
  -inicioParalisacao : DateTime
  -fimParalisacao : DateTime
  --
  +registrarFotografia(f : RegistroFotografico) : void
  +alterarFotografia(f : RegistroFotografico) : void
  +excluirFotografia(f : RegistroFotografico) : void
}

class RegistroAuditoria <<Entity>> {
  -id : int
  -idAuditavel : int
  -acao : AcaoAuditoria
  -usuario : Usuario
  -dataHora : DateTime
}

class RegistroFotografico <<Entity>> {
  -id : int
  -idOcorrencia: int
  -arquivo : String
  -legenda : String
  -dataEnvio : DateTime
}

' ===== ENUMERAÇÕES =====
enum StatusObra {
  PLANEJADA
  EM_ANDAMENTO
  PARALISADA
  CANCELADA
  CONCLUIDA
}

enum Tipologia {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
  INFRAESTRUTURA
  REFORMA
  RESTAURO
}

enum CondicaoClimatica {
  ENSOLARADO
  NUBLADO
  CHUVA_FRACA
  CHUVA_FORTE
}

enum CategoriaOcorrencia {
  INTEMPERIE
  PARALISACAO
  LOGISTICA
  SEGURANCA
  OUTRO
}

enum AcaoAuditoria {
  CRIACAO
  EDICAO
  EXCLUSAO
}

' ===== RELAÇÕES =====
RegistroDiario "0..1" --> "0..*" Ocorrencia : contem
Ocorrencia "0..1" --> "0..*" RegistroFotografico : contem
AlocacaoObra "1" --> "0..*" Ocorrencia : registra
Usuario "1" --> "0..*" AlocacaoObra : alocado em
Cargo "1..*" --> "0..*" AlocacaoObra : define papeis
Obra "1" *-- "0..*" AlocacaoObra : membro de
Orcamento "0..1" --> "1" Obra : informa
Cronograma "0..1" --> "1" Obra : informa
Obra "1" *-- "0..*" RegistroDiario : possui
Auditavel "1" --> "0..*" RegistroAuditoria : historico
Auditavel <|-- Ocorrencia
Auditavel <|-- RegistroDiario
Auditavel <|-- RegistroFotografico

@enduml